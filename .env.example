# Storage Configuration
STORAGE_TYPE=local # local | nas | s3
INPUT_DIR=./data/ingest
PROCESSING_DIR=./data/processing
OUTPUT_DIR=./data/output

# AWS S3 Placeholders (used if STORAGE_TYPE=s3)
S3_BUCKET_NAME=my-storyteller-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Storyteller Service Configuration
STORYTELLER_URL=http://storyteller:8000
STORYTELLER_API_KEY=

# TTS Configuration
TTS_MODEL_NAME=tts_models/en/vctk/vits
